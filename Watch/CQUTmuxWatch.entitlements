<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Shared with the complication extension so the usage it shows is the
	     usage the phone pushed. See WatchWidgets/CQUTmuxWatchWidgets.swift. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.app.cqutmux.ios</string>
	</array>
</dict>
</plist>
