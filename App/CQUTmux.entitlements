<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The App Group the Live Activity's Lock Screen buttons write decisions
	     into. The widget extension has its own container; this is the one place
	     the two processes meet, and without it on the app side the decisions a
	     tap left behind are unreadable. See App/Shared/MobileDecision.swift. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.app.cqutmux.ios</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)app.cqutmux.ios</string>
	</array>
	<!-- Settings sync. The private database only: the payload is host names,
	     preferences and theme colours, and the public database would be the
	     wrong place for every one of them. -->
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.app.cqutmux.ios</string>
	</array>
	<key>com.apple.developer.ubiquity-kvstore-identifier</key>
	<string>$(TeamIdentifierPrefix)$(CFBundleIdentifier)</string>
</dict>
</plist>