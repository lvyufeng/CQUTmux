<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The complication is a separate process from the watch app and cannot
	     see its WatchConnectivity context, so the latest usage payload is handed
	     over through this container. Both targets must carry the same group. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.app.cqutmux.ios</string>
	</array>
</dict>
</plist>
