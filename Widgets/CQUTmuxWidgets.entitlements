<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Shared with the app so a Lock Screen button can leave a decision where
	     the app will find it. A widget extension is a separate process; without
	     this the tap writes into a container nothing else can read and the
	     approval quietly stays pending. See App/Shared/MobileDecision.swift. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.app.cqutmux.ios</string>
	</array>
</dict>
</plist>
